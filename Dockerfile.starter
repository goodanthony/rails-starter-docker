# syntax=docker/dockerfile:1

ARG RUBY_VERSION=4.0.6
ARG NODE_VERSION=24
ARG DEBIAN_RELEASE=bookworm

# Keep Node on the current LTS line and Ruby on an exact stable patch.
FROM node:${NODE_VERSION}-${DEBIAN_RELEASE}-slim AS node
FROM ruby:${RUBY_VERSION}-slim-${DEBIAN_RELEASE}

ARG USER_ID=1000
ARG GROUP_ID=1000
ARG BUNDLER_VERSION=4.0.17
ARG RAILS_VERSION=8.1.3

ENV APP_PATH=/work \
  BINDING=0.0.0.0 \
  RAILS_ENV=development \
  RAILS_LOG_TO_STDOUT=true \
  RAILS_SERVE_STATIC_FILES=true \
  BUNDLE_JOBS=4 \
  BUNDLE_RETRY=3 \
  BUNDLE_PATH=/usr/local/bundle

# System deps
RUN apt-get update && \
  DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
  build-essential git curl tzdata \
  libpq-dev libxml2-dev libxslt-dev libvips \
  gnupg2 wget lsb-release ca-certificates \
  && rm -rf /var/lib/apt/lists/*

# PostgreSQL client 18 via PGDG (use dearmored keyring with signed-by)
RUN install -d /usr/share/keyrings \
  && curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc \
  | gpg --dearmor -o /usr/share/keyrings/postgresql.gpg \
  && chmod 0644 /usr/share/keyrings/postgresql.gpg \
  && echo "deb [signed-by=/usr/share/keyrings/postgresql.gpg] http://apt.postgresql.org/pub/repos/apt/ $(lsb_release -cs)-pgdg main" \
  > /etc/apt/sources.list.d/pgdg.list \
  && apt-get update \
  && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends postgresql-client-18 \
  && rm -rf /var/lib/apt/lists/*

# Keep the generator toolchain separate from the replaceable application
# bundle volume.
ENV GEM_HOME=/usr/local/rails-toolchain \
  PATH=/usr/local/rails-toolchain/bin:${PATH}

# Install the exact generator toolchain.
RUN gem install bundler -v "${BUNDLER_VERSION}" --no-document \
  && gem install rails -v "${RAILS_VERSION}" --no-document

# Copy only the Node toolchain; copying all of /usr/local would overwrite Ruby
# executables installed in the previous layer.
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules

# Enable Corepack shims for Rails apps generated with a JavaScript bundler.
RUN ln -sf ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
  && ln -sf ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
  && ln -sf ../lib/node_modules/corepack/dist/corepack.js /usr/local/bin/corepack \
  && corepack enable

# App directory & source
WORKDIR ${APP_PATH}
COPY --chown=${USER_ID}:${GROUP_ID} . ${APP_PATH}

# Non-root user
RUN groupadd --gid ${GROUP_ID} app \
  && useradd --uid ${USER_ID} --gid ${GROUP_ID} --create-home app \
  && chown -R app:app ${APP_PATH} /usr/local/bundle
USER app

EXPOSE 3000

# Support both full-stack apps (bin/dev) and API-only apps (bin/rails).
# Before generation, keep the service alive so it can be used interactively.
CMD ["bash", "-c", "if [ -x ./bin/dev ]; then exec ./bin/dev; elif [ -x ./bin/rails ]; then exec ./bin/rails server -b 0.0.0.0; else echo 'No Rails app yet. Follow README.md to generate one.'; exec tail -f /dev/null; fi"]
